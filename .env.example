# ==========================================
# StudySpace Club - Environment Configuration
# ==========================================

# ------------------------------------------
# SUPABASE CONFIGURATION (Public & Service)
# ------------------------------------------
# Client-side safe Supabase URL
VITE_SUPABASE_URL=https://your-project.supabase.co

# Client-side safe Supabase Anonymous Key
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# SERVER-ONLY: Supabase Service Role Key (NEVER expose to browser client)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# ------------------------------------------
# APPLICATION CONFIGURATION
# ------------------------------------------
VITE_APP_URL=https://studyspace.club
VITE_ENVIRONMENT=production

# ------------------------------------------
# PAYMENT INTEGRATION (RAZORPAY)
# ------------------------------------------
# Client-side safe Key ID
VITE_RAZORPAY_KEY_ID=rzp_live_your_key_id_here

# SERVER-ONLY: Razorpay Secret (NEVER expose to browser client)
RAZORPAY_KEY_SECRET=your_razorpay_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# ------------------------------------------
# MESSAGING INTEGRATION (WHATSAPP / SMS)
# ------------------------------------------
# SERVER-ONLY Credentials
WHATSAPP_API_KEY=your_whatsapp_api_key_here
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id_here
SMS_GATEWAY_API_KEY=your_sms_gateway_api_key_here

# ------------------------------------------
# TELEPHONY INTEGRATION (EXOTEL / CALLING)
# ------------------------------------------
# SERVER-ONLY Credentials
TELEPHONY_ACCOUNT_SID=your_exotel_account_sid_here
TELEPHONY_API_KEY=your_exotel_api_key_here
TELEPHONY_API_TOKEN=your_exotel_api_token_here
TELEPHONY_CALLER_ID=your_exotel_virtual_number_here
